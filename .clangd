CompileFlags:
  CompilationDatabase: build
  Add:
    - -I/home/pldx/Desktop/talos-master/build/_deps/spdlog-src/include
    - -I/home/pldx/Desktop/talos-master/build/_deps/fmt-src/include
    - -I/home/pldx/Desktop/talos-master/crates/toml/src
    - -I/home/pldx/Desktop/talos-master/crates/primitive/src
    - -I/home/pldx/Desktop/talos-master/crates/scheduler/src
    - -I/home/pldx/Desktop/talos-master/crates/fast_tf/src
    - -I/home/pldx/Desktop/talos-master/crates/math/src
    - -I/home/pldx/Desktop/talos-master/crates/log/src
    - -I/home/pldx/Desktop/talos-master/src
    - -I/home/pldx/Desktop/talos-master/src/fcs_visualization
    - -I/home/pldx/Desktop/talos-master/3dparty/boost-pfr/include
    - -I/home/pldx/Desktop/talos-master/3dparty/magic_enum
    - -I/home/pldx/Desktop/talos-master/build/_deps/tomlplusplus-src/include
    - -I/home/pldx/Desktop/talos-master/build/_deps/eigen-src/include
    - -I/home/pldx/Desktop/talos-master/build/_deps/foxglove-src/include
    - -I/home/pldx/Desktop/talos-master/build/_deps/foxglove-src/include/foxglove
    - -I/home/pldx/Desktop/talos-master/build/include_foxglove
    - -std=c++2b

Diagnostics:
  ClangTidy:
    Remove:
      - misc-include-cleaner

---
# Axera NPU后端：依赖AX650专有SDK头文件(ax_engine_api.h等)
# 当前开发机未安装，CMake通过AXERA_FOUND条件编译排除，clangd报错为误报
If:
  PathMatch: "src/fcs/L2_perception/armor/backends/axera\\.(cpp|hpp)"
Diagnostics:
  Suppress:
    - "*"

---
# TensorRT后端：依赖NVIDIA TensorRT头文件(NvInfer.h)
# 当前开发机未安装，CMake通过TensorRT_FOUND条件编译排除，clangd报错为误报
If:
  PathMatch: "src/fcs/L2_perception/armor/backends/tensor_rt\\.(cpp|hpp)"
Diagnostics:
  Suppress:
    - "*"

---
# CUDA Letterbox预处理：依赖CUDA Toolkit(__global__等关键字)
# 当前开发机未安装CUDA，CMake通过CUDA_FOUND条件编译排除，clangd报错为误报
If:
  PathMatch: "src/fcs/L2_perception/armor/backends/letterbox\\.cu(h)?"
Diagnostics:
  Suppress:
    - "*"
