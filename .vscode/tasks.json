{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "talos",
            "type": "shell",
            "command": "bash",
            "args": [
                "-c",
                "cmake -DENABLE_CALIBRATION=OFF -G Ninja -B build -S . && cmake --build build --target talos -j64 && ./build/bin/talos"
            ],
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "calibration",
            "type": "shell",
            "command": "bash",
            "args": [
                "-c",
                "cmake -DENABLE_CALIBRATION=ON -G Ninja -B build -S . && cmake --build build --target rm_calibration -j64 && ./build/bin/rm_calibration"
            ],
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "optimizer",
            "type": "shell",
            "command": "bash",
            "args": [
                "-c",
                "cd rateui && cargo run"
            ],
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            },
            "problemMatcher": []
        }
    ]
}