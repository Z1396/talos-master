# ===========================================================================
# 覆盖上级 talos-master/.clangd 的 CompilationDatabase 设置
# ---------------------------------------------------------------------------
# 上级 .clangd 将编译数据库强制指向 talos 主项目的 build/，
# 本 stage 源文件在其中找不到编译记录，clangd 退回盲猜模式、
# 缺失 -I 头文件路径（crates/hardware_daedalus/src、fmt、OpenCV），
# 从而 #include "shm_client.hpp" 等全部飘红。
# 这里把编译数据库重新指向本项目自己的 build/compile_commands.json。
# 本项目是 C++23（CDB 命令自带 -std=gnu++2b），显式锁定标准版本。
# ===========================================================================
CompileFlags:
  CompilationDatabase: build
  Add:
    - -std=gnu++2b    # 显式锁定 C++23（GNU 扩展模式），与项目实际编译标准一致
