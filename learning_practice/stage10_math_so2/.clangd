# ===========================================================================
# 覆盖上级 talos-master/.clangd 的 CompilationDatabase 设置
# ---------------------------------------------------------------------------
# 本项目尚未构建（无 build/compile_commands.json），clangd 无法从数据库
# 获得 -I 路径。这里显式列出头文件搜索路径（与 CMakeLists.txt 的
# target_include_directories 一致），保证未构建时也不飘红。
#   math 真实源码   ：crates/math/src（so2.hpp / euler.hpp）
#   lieplusplus     ：3dparty/lieplusplus（euler.hpp 依赖 groups/SO3.hpp）
#   Eigen           ：主项目构建缓存 build/_deps/eigen-src/include
# ===========================================================================
CompileFlags:
  CompilationDatabase: build
  Add:
    - -std=gnu++2b    # 显式锁定 C++23（GNU 扩展模式），与项目实际编译标准一致
    - -I/home/pldx/Desktop/talos-master/crates/math/src
    - -I/home/pldx/Desktop/talos-master/3dparty/lieplusplus
    - -I/home/pldx/Desktop/talos-master/build/_deps/eigen-src/include
