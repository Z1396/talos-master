# ===========================================================================
# 覆盖上级 talos-master/.clangd 的 CompilationDatabase 设置
# ---------------------------------------------------------------------------
# 上级 talos-master/.clangd 将编译数据库强制指向 talos 主项目的 build/，
# 导致本项目（stage2_cmake）源文件在其中找不到编译记录，clangd 退回盲猜模式、
# 缺失 -I 头文件路径，从而 #include 全部飘红。
# 这里把编译数据库重新指向本项目自己的 build/compile_commands.json
# （相对路径相对于本 .clangd 所在目录）。
# ===========================================================================
CompileFlags:
  CompilationDatabase: build
  Remove:
    - -std=c++2b    # 移除上级追加的 C++23 标志，改用本项目数据库中的 -std=gnu++20
